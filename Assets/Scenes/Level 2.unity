      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2876994341039843212, guid: f4107441329a2174da2d4ec4e8e79f10, type: 3}
      propertyPath: witnessesInLevel
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 4458321516921020908, guid: f4107441329a2174da2d4ec4e8e79f10, type: 3}
